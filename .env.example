COMPOSE_PROJECT_NAME=nexora

# TLS. Həm əsas domain, həm də www DNS qeydi deploy serverinə yönəlməlidir.
TLS_DOMAIN=nexoracademy.az
TLS_WWW_DOMAIN=www.nexoracademy.az
TLS_EMAIL=replace-with-real-operations-email

DB_NAME=nexora_academy
DB_USER=nexora_app
DB_PASSWORD=replace-with-a-strong-database-password
DB_PORT=5432

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=nexora-academy
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000
CORS_ALLOWED_ORIGINS=https://nexoracademy.az,https://www.nexoracademy.az

ADMIN_SEED_ENABLED=true
ADMIN_SEED_EMAIL=admin@nexoracademy.az
ADMIN_SEED_PASSWORD=replace-with-a-strong-initial-admin-password

REDIS_PASSWORD=replace-with-a-strong-redis-password
OPENROUTER_API_KEY=replace-with-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini

# Chatbotun Java kataloq cache-i və daxili sorğu timeout-u.
CATALOG_CACHE_TTL_S=300
CATALOG_TIMEOUT_S=4
